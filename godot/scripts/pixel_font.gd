static func has_glyph(ch: String) -> bool:
	return GLYPHS.has(ch)


static func text_width(text: String, px: int) -> float:
	if text.is_empty():
		return 0.0
	return float(text.length() * ADVANCE - 1) * float(px)


static func draw_text(canvas: CanvasItem, text: String, pos: Vector2, px: int, col: Color, align: int = HORIZONTAL_ALIGNMENT_LEFT, width: float = 0.0) -> void:
	if text.is_empty() or px <= 0:
		return
	var x := pos.x
	if align == HORIZONTAL_ALIGNMENT_CENTER:
		x = pos.x + (width - text_width(text, px)) * 0.5
	elif align == HORIZONTAL_ALIGNMENT_RIGHT:
		x = pos.x + width - text_width(text, px)
	var fpx := float(px)
	for ci in range(text.length()):
		# String[] returns an int code in Godot 4: use substr so the
		# glyph lookup gets a real one-char String.
		var ch := text.substr(ci, 1)
		var rows: Array = GLYPHS.get(ch, [])
		if rows.is_empty():
			x += float(ADVANCE) * fpx
			continue
		for ry in range(GLYPH_H):
			var row: String = rows[ry]
			for rx in range(GLYPH_W):
				# String[] returns an int code in Godot 4, not a
				# String: compare via substr. Glyph rows use '1'
				# for a filled pixel (not '#').
				if row.substr(rx, 1) == "1":
					canvas.draw_rect(Rect2(x + float(rx) * fpx, pos.y + float(ry) * fpx, fpx, fpx), col)
		x += float(ADVANCE) * fpx
